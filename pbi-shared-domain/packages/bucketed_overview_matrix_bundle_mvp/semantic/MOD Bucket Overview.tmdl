table 'MOD Bucket Overview'

	measure 'Bucket Overview Selected N' = SELECTEDVALUE('_MOD Bucket Overview N'[TopN], 5)
		formatString: 0
		displayFolder: Selection

	measure 'Bucket Overview Selected Target Entity' =
			
			VAR TargetEntity = SELECTEDVALUE('_MOD Bucket Overview Targets'[TargetEntity])
			RETURN
			IF(TargetEntity = "(No target)", BLANK(), TargetEntity)
		displayFolder: Selection

	measure 'Bucket Overview Selected Group Key' = SELECTEDVALUE('_MOD Bucket Overview Structure'[GroupKey], "primary")
		displayFolder: Selection

	measure 'Bucket Overview Selected Group Label' = SELECTEDVALUE('_MOD Bucket Overview Structure'[GroupLabel], "Primary")
		displayFolder: Selection

	measure 'Bucket Overview Selected Metric Key' = SELECTEDVALUE('_MOD Bucket Overview Structure'[MetricKey], "current")
		displayFolder: Selection

	measure 'Bucket Overview Selected Metric Label' = SELECTEDVALUE('_MOD Bucket Overview Structure'[MetricLabel], "ACT")
		displayFolder: Selection

	measure 'Bucket Overview Selected Column Key' = SELECTEDVALUE('_MOD Bucket Overview Structure'[ColumnKey], "primary_current")
		displayFolder: Selection

	measure 'Bucket Overview Current Entity' =
			
			VAR Slot = SELECTEDVALUE('_MOD Bucket Overview Slots'[Slot])
			VAR SlotIndex = SELECTEDVALUE('_MOD Bucket Overview Slots'[NIndex])
			VAR TargetEntity = [Bucket Overview Selected Target Entity]
			VAR CandidateEntities =
			    FILTER(
			        ALLSELECTED(MOD_BIND_ENTITY_DIMENSION[Value]),
			        NOT ISBLANK(MOD_BIND_ENTITY_DIMENSION[Value]) &&
			        (ISBLANK(TargetEntity) || (MOD_BIND_ENTITY_DIMENSION[Value] & "") <> TargetEntity)
			    )
			VAR RankedEntitiesRaw =
			    ADDCOLUMNS(
			        CandidateEntities,
			        "__ranking_value", CALCULATE('_MOD Bucket Overview Inputs'[Bucket Overview Input Ranking Measure])
			    )
			VAR RankedEntities =
			    FILTER(RankedEntitiesRaw, NOT ISBLANK([__ranking_value]))
			VAR AvailableEntities = COUNTROWS(RankedEntities)
			VAR EffectiveN = MIN([Bucket Overview Selected N], AvailableEntities)
			VAR TopEntities =
			    TOPN(
			        EffectiveN,
			        RankedEntities,
			        [__ranking_value], DESC,
			        MOD_BIND_ENTITY_DIMENSION[Value], ASC
			    )
			VAR HasNth =
			    NOT ISBLANK(SlotIndex) &&
			    SlotIndex >= 1 &&
			    SlotIndex <= EffectiveN
			VAR NthEntity =
			    IF(
			        HasNth,
			        MAXX(
			            TOPN(
			                1,
			                TOPN(
			                    SlotIndex,
			                    TopEntities,
			                    [__ranking_value], DESC,
			                    MOD_BIND_ENTITY_DIMENSION[Value], ASC
			                ),
			                [__ranking_value], ASC,
			                MOD_BIND_ENTITY_DIMENSION[Value], DESC
			            ),
			            MOD_BIND_ENTITY_DIMENSION[Value] & ""
			        )
			    )
			VAR HasOthers = AvailableEntities > EffectiveN
			RETURN
			SWITCH(
			    TRUE(),
			    Slot = "TARGET", TargetEntity,
			    Slot = "OTHERS", IF(HasOthers, "OTHERS", BLANK()),
			    LEFT(Slot, 3) = "TOP" && HasNth, NthEntity,
			    BLANK()
			)
		displayFolder: Outputs

	measure 'Bucket Overview Rank' =
			
			VAR Slot = SELECTEDVALUE('_MOD Bucket Overview Slots'[Slot])
			VAR SlotIndex = SELECTEDVALUE('_MOD Bucket Overview Slots'[NIndex])
			RETURN
			SWITCH(
			    TRUE(),
			    Slot = "TARGET", 0,
			    LEFT(Slot, 3) = "TOP", SlotIndex,
			    BLANK()
			)
		formatString: 0
		displayFolder: Outputs

	measure 'Bucket Overview Primary Current' =
			
			VAR Slot = SELECTEDVALUE('_MOD Bucket Overview Slots'[Slot])
			VAR CurrentEntity = [Bucket Overview Current Entity]
			VAR TargetEntity = [Bucket Overview Selected Target Entity]
			VAR CandidateEntities =
			    FILTER(
			        ALLSELECTED(MOD_BIND_ENTITY_DIMENSION[Value]),
			        NOT ISBLANK(MOD_BIND_ENTITY_DIMENSION[Value]) &&
			        (ISBLANK(TargetEntity) || (MOD_BIND_ENTITY_DIMENSION[Value] & "") <> TargetEntity)
			    )
			VAR RankedEntitiesRaw =
			    ADDCOLUMNS(
			        CandidateEntities,
			        "__ranking_value", CALCULATE('_MOD Bucket Overview Inputs'[Bucket Overview Input Ranking Measure])
			    )
			VAR RankedEntities =
			    FILTER(RankedEntitiesRaw, NOT ISBLANK([__ranking_value]))
			VAR EffectiveN = MIN([Bucket Overview Selected N], COUNTROWS(RankedEntities))
			VAR TopEntities =
			    TOPN(
			        EffectiveN,
			        RankedEntities,
			        [__ranking_value], DESC,
			        MOD_BIND_ENTITY_DIMENSION[Value], ASC
			    )
			VAR TopEntityNames =
			    SELECTCOLUMNS(
			        TopEntities,
			        "EntityText", MOD_BIND_ENTITY_DIMENSION[Value] & ""
			    )
			VAR OthersEntities =
			    FILTER(
			        ALLSELECTED(MOD_BIND_ENTITY_DIMENSION[Value]),
			        NOT ISBLANK(MOD_BIND_ENTITY_DIMENSION[Value]) &&
			        (ISBLANK(TargetEntity) || (MOD_BIND_ENTITY_DIMENSION[Value] & "") <> TargetEntity) &&
			        NOT CONTAINS(TopEntityNames, [EntityText], MOD_BIND_ENTITY_DIMENSION[Value] & "")
			    )
			RETURN
			SWITCH(
			    TRUE(),
			    Slot = "TARGET" && NOT ISBLANK(TargetEntity),
			        CALCULATE(
			            '_MOD Bucket Overview Inputs'[Bucket Overview Input Primary Current Measure],
			            FILTER(
			                ALLSELECTED(MOD_BIND_ENTITY_DIMENSION[Value]),
			                (MOD_BIND_ENTITY_DIMENSION[Value] & "") = TargetEntity
			            )
			        ),
			    Slot = "OTHERS",
			        VAR OthersList = SELECTCOLUMNS(OthersEntities, "EntityValue", MOD_BIND_ENTITY_DIMENSION[Value])
			        RETURN
			        IF(
			            COUNTROWS(OthersEntities) = 0,
			            BLANK(),
			            CALCULATE(
			                '_MOD Bucket Overview Inputs'[Bucket Overview Input Primary Current Measure],
			                TREATAS(OthersList, MOD_BIND_ENTITY_DIMENSION[Value])
			            )
			        ),
			    LEFT(Slot, 3) = "TOP" && NOT ISBLANK(CurrentEntity),
			        CALCULATE(
			            '_MOD Bucket Overview Inputs'[Bucket Overview Input Primary Current Measure],
			            FILTER(
			                ALLSELECTED(MOD_BIND_ENTITY_DIMENSION[Value]),
			                (MOD_BIND_ENTITY_DIMENSION[Value] & "") = CurrentEntity
			            )
			        ),
			    BLANK()
			)
		displayFolder: Outputs

