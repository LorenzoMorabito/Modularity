			            )
			        ),
			    BLANK()
			)
		displayFolder: Outputs

	measure 'Bucket Overview Primary Current Total' = '_MOD Bucket Overview Inputs'[Bucket Overview Input Primary Current Total Measure]
		displayFolder: Outputs

	measure 'Bucket Overview Primary Previous Year Total' = '_MOD Bucket Overview Inputs'[Bucket Overview Input Primary Previous Year Total Measure]
		displayFolder: Outputs

	measure 'Bucket Overview Primary Share' = DIVIDE([Bucket Overview Primary Current], [Bucket Overview Primary Current Total])
		displayFolder: Outputs

	measure 'Bucket Overview Primary Share PY' = DIVIDE([Bucket Overview Primary Previous Year], [Bucket Overview Primary Previous Year Total])
		displayFolder: Outputs

	measure 'Bucket Overview Primary QoQ%' = DIVIDE([Bucket Overview Primary Current] - [Bucket Overview Primary Previous Quarter], [Bucket Overview Primary Previous Quarter])
		displayFolder: Outputs

	measure 'Bucket Overview Primary YoY%' = DIVIDE([Bucket Overview Primary Current] - [Bucket Overview Primary Previous Year], [Bucket Overview Primary Previous Year])
		displayFolder: Outputs

	measure 'Bucket Overview Primary EI' =
			
			VAR SharePY = [Bucket Overview Primary Share PY]
			RETURN
			IF(ISBLANK(SharePY), BLANK(), DIVIDE([Bucket Overview Primary Share], SharePY) * 100)
		displayFolder: Outputs

