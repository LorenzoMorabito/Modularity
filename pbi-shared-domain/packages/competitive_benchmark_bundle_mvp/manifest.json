        "minItems": 1,
        "maxItems": 8,
        "defaultVisibleCount": 4,
        "bindingKeyPrefix": "MOD_BIND_SELECTOR_MEASURE_",
        "defaultItems": [
          {
            "label": "Measure 1",
            "description": "Primary benchmark metric.",
            "defaultValue": "Sales Values",
            "suggestions": [
