table '_MOD Bucket Family Legend'
	isHidden

	column Legend
		summarizeBy: none
		isNameInferred
		sourceColumn: [Legend]

	partition '_MOD Bucket Family Legend' = calculated
		mode: import
		source = ```
				VAR Entities =
				    SELECTCOLUMNS(
				        FILTER(
				            VALUES(MOD_BIND_ENTITY_DIMENSION[Value]),
				            NOT ISBLANK(MOD_BIND_ENTITY_DIMENSION[Value])
				        ),
				        "Legend", MOD_BIND_ENTITY_DIMENSION[Value] & ""
				    )
				RETURN
				DISTINCT(
				    UNION(
				        Entities,
				        DATATABLE("Legend", STRING, {{"OTHERS"}})
				    )
				)
				```
